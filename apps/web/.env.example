# Read-only MySQL user on a staging/test copy of the existing legacy database.
# Keep real credentials in .env.local (gitignored); never use a production URL here.
DATABASE_URL="mysql://read_only_user:replace_me@127.0.0.1:3306/kkisi_staging"
# Auth/session configuration is part of Checkpoint 2B.

# --- Stage 2A auth (local staging only) ---
# Auth store account (schema kkisi_auth_staging). Created by scripts/setup-auth-store.sh; never commit the real value.
DATABASE_URL_AUTH="mysql://kkisi_auth:<generated>@127.0.0.1:3307/kkisi_auth_staging?connection_limit=8"
# Session/CSRF/throttle key ring "kid:base64,kid:base64" (first = active); each key >= 32 random bytes, e.g. openssl rand -base64 48.
AUTH_SECRETS="k1:<base64 of 32+ random bytes>"
# Exact browser origin. Must be loopback (http://127.0.0.1:3000); anything else makes authentication refuse to start.
APP_ORIGIN="http://127.0.0.1:3000"
# Number of trusted reverse proxies that overwrite X-Forwarded-For. Leave unset/0 unless one exists: per-IP throttling is then off.
# TRUSTED_PROXY_HOPS=0

# --- POS finalization (local staging only; provision separately under the existing plan) ---
# Disabled unless explicitly enabled. Never point at the operational/production database.
POS_WRITES_ENABLED=0
POS_WRITE_DATABASE="kkisi_staging"
DATABASE_URL_WRITE="mysql://pos_writer:replace_me@127.0.0.1:3306/kkisi_staging"
DATABASE_URL_REGISTER_WRITE="mysql://pos_register:replace_me@127.0.0.1:3306/kkisi_staging"
# Optional: legacy encrypted member QR; obtain matching values through the approved secret-management process.
# POS_QR_CIPHER="aes-256-cbc"
# POS_QR_SECRET_KEY="replace_me"
# POS_QR_SECRET_IV="replace_me"
