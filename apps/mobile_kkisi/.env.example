# S-MART KKISI TB2 — PWA Anggota (apps/mobile_kkisi). Copy to .env.local (never commit real values).
# Every setting fails closed: a missing or unsafe value makes login unavailable instead of falling back to a default.

# production | staging | development. production enforces HTTPS origin, a database session store and non-loopback DSNs.
APP_ENV=development

# Exact public origin of this app (no path). Local: http://127.0.0.1:3240  Production: https://app.kkisitb2.id
APP_ORIGIN=http://127.0.0.1:3240

# Number of trusted reverse proxies in front of Next (0-5). Only then is X-Forwarded-For used for per-IP throttling.
TRUSTED_PROXY_HOPS=0

# Session-id HMAC key(s): kid:base64 (>= 32 bytes). First entry signs; later entries are accepted during rotation.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
MEMBER_AUTH_SECRETS=

# SELECT-only account on the legacy business database (smart_kopkar). Needs SELECT on the tables listed in
# docs/mobile_design_pwa/implementation/05_API_INTEGRATION.md only. Never a writer account.
DATABASE_URL_MEMBER_READ=mysql://mobile_reader:CHANGE_ME@127.0.0.1:3306/smart_kopkar

# Session/throttle store owned by this app (schema: db/auth/001_member_auth.sql). Its own account and database.
DATABASE_URL_MEMBER_AUTH=mysql://mobile_auth:CHANGE_ME@127.0.0.1:3306/kkisi_member_auth

# Local development only: keep sessions in process memory instead of DATABASE_URL_MEMBER_AUTH. Refused when APP_ENV=production.
# MEMBER_AUTH_STORE=memory

# Store whose catalog the Belanja screen shows (db_company.id). 1 = TOKO S-MART TB II.
MEMBER_CATALOG_COMPANY_ID=1

# Reader connections per process (1-4). The legacy reader server is shared with POS; keep this small.
MEMBER_DB_POOL_LIMIT=2
