# Host nginx site for genesis.web ONLY: /etc/nginx/sites-available/genesis-web (symlinked into sites-enabled).
# Do not edit nginx.conf or any other application's site. Certificate: issued with the webroot authenticator, so certbot
# never edits nginx files:
#   certbot certonly --webroot -w /var/www/genesis-web-acme -d smart.kkisitb2.id --deploy-hook "systemctl reload nginx"
# Another site on the server already sets `ipv6only=on` for [::]:443; it may appear only once per address, so not here.
# No http2 directive: nginx 1.18 (Ubuntu 22.04) lacks `http2 on`, and `listen ... http2` would change every site on :443.

server {
    listen 80;
    listen [::]:80;
    server_name smart.kkisitb2.id;
    location ^~ /.well-known/acme-challenge/ { root /var/www/genesis-web-acme; default_type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name smart.kkisitb2.id;

    ssl_certificate     /etc/letsencrypt/live/smart.kkisitb2.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/smart.kkisitb2.id/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 2m;

    # Readiness touches both databases: reachable from the server itself only, not from the internet.
    location = /health/ready {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:3140;
    }

    location / {
        proxy_pass http://127.0.0.1:3140;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # OVERWRITE (never append) X-Forwarded-For: the app trusts exactly one hop (TRUSTED_PROXY_HOPS=1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
