# Template for /opt/apps/genesis.web/.env.production on the genesis.web server (mode 600). PLACEHOLDERS ONLY: never commit real values.
# The application refuses to start (exit 1, one-line safe reason in the log) when anything here is missing or unsafe.

# --- Deployment target --------------------------------------------------------------------------------------------
APP_ENV=production
# Exact public HTTPS origin served by the host nginx (no path). Required for CSRF and the __Host-/Secure session cookie.
APP_ORIGIN=https://REPLACE_WITH_DOMAIN
# nginx overwrites X-Forwarded-For with the client address: exactly one trusted hop.
TRUSTED_PROXY_HOPS=1
# Session/CSRF/throttle key ring "kid:base64" (>= 32 random bytes each; first = active). openssl rand -base64 48
AUTH_SECRETS=k1:REPLACE_WITH_BASE64_SECRET

# --- Production MariaDB (Niagahoster cPanel) explicit allowlist ---------------------------------------------------
# Transport is explicit. "ssh-tunnel" (current): the db-tunnel sidecar forwards 127.0.0.1:3307 inside the app's private
# network namespace over SSH (port 65002) to 127.0.0.1:3306 on the server; the server offers no TLS (2026-10-05).
# "direct" keeps the original rules (remote hostname, ALLOW_REMOTE_LEGACY_DB=true, LEGACY_DB_TLS declared).
# Loopback is accepted ONLY with ssh-tunnel. Every DSN below must name exactly this host, port and database.
LEGACY_DB_TRANSPORT=ssh-tunnel
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3307
LEGACY_DB_NAME=n1608204_smart_kopkar
# Identity of the real server, compared at startup with @@hostname / @@port (proves what is behind the tunnel).
LEGACY_DB_SERVER_HOSTNAME=srv149.niagahoster.com
LEGACY_DB_SERVER_PORT=3306
# Direct mode only:
# ALLOW_REMOTE_LEGACY_DB=true
# LEGACY_DB_TLS=required|disabled-acknowledged
# Upper bound of connections this ONE process may open to that server (sum of connection_limit of all clients on it,
# auth store included). Max 12 of max_user_connections = 20.
LEGACY_DB_CONNECTION_BUDGET=10

# Every DSN: dedicated cPanel account (never root/admin/the legacy PHP account n1608204_kkisi), connection_limit 1..4 and
# max_idle_connection_lifetime <= 15 (server wait_timeout = 20 s; without it Prisma reuses dead sockets -> P1017).
# Read-only account n1608204_nxread (cPanel privilege: SELECT only). Verified SELECT-only at startup via SHOW GRANTS.
DATABASE_URL=mysql://n1608204_nxread:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_smart_kopkar?connection_limit=3&max_idle_connection_lifetime=10&connect_timeout=10&pool_timeout=10

# --- Auth store (sessions + login throttle; separate database n1608204_kkisi_auth, never the legacy schema) -------
AUTH_DB_TRANSPORT=ssh-tunnel
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3307
AUTH_DB_NAME=n1608204_kkisi_auth
AUTH_DB_SERVER_HOSTNAME=srv149.niagahoster.com
AUTH_DB_SERVER_PORT=3306
# n1608204_nxauth: SELECT/INSERT/UPDATE/DELETE on n1608204_kkisi_auth only (startup refuses any business-DB grant or DDL).
DATABASE_URL_AUTH=mysql://n1608204_nxauth:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_kkisi_auth?connection_limit=2&max_idle_connection_lifetime=10&connect_timeout=10&pool_timeout=10

# --- Console store (OPTIONAL, disabled: unset). Identity links + audit; separate database and account (owner decision 16 Oct 2026).
# Prepare with docs/migration/sql/console-store-production.sql (operator only). Counts against the SAME connection budget:
# the documented 11 pools + this 1 = 12 = the ceiling, so LEGACY_DB_CONNECTION_BUDGET must be raised to 12 explicitly (the
# startup guard refuses to start otherwise). Leaves 8 of max_user_connections = 20 to the legacy PHP application.
# CONSOLE_DB_TRANSPORT=ssh-tunnel
# CONSOLE_DB_HOST=127.0.0.1
# CONSOLE_DB_PORT=3307
# CONSOLE_DB_NAME=n1608204_kkisi_console
# CONSOLE_DB_SERVER_HOSTNAME=srv149.niagahoster.com
# CONSOLE_DB_SERVER_PORT=3306
# DATABASE_URL_CONSOLE=mysql://n1608204_nxcon:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_kkisi_console?connection_limit=1&max_idle_connection_lifetime=10&connect_timeout=10&pool_timeout=10
# CONSOLE_ENABLED=true          # unified console (rollback: unset)
# KOSIPA_READ_ENABLED=true      # read-only KOSIPA pages; needs the console store above (rollback: unset)

# --- Legacy writes (disabled by default) -----------------------------------------------------------------------------
# Writes need BOTH the global acknowledgement and the module flag; each writer has its own account and must not hold
# DDL privileges (verified at startup). Enabling writes while PHP also writes the same branch is NOT single-writer:
# see docs/migration/GCP_PARTIAL_CUTOVER.md before setting any of these.
ALLOW_PRODUCTION_DB_WRITE=false
POS_WRITES_ENABLED=0
POS_WRITE_DATABASE=n1608204_smart_kopkar
# DATABASE_URL_WRITE=mysql://n1608204_nxpos:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_smart_kopkar?connection_limit=2&max_idle_connection_lifetime=10&connect_timeout=10&pool_timeout=10
# DATABASE_URL_REGISTER_WRITE=mysql://n1608204_nxreg:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_smart_kopkar?connection_limit=1&max_idle_connection_lifetime=10&connect_timeout=10&pool_timeout=10
INVENTORY_WRITES_ENABLED=0
# DATABASE_URL_INVENTORY_WRITE=...
PRODUCTS_WRITES_ENABLED=0
# DATABASE_URL_PRODUCT_WRITE=...
# Sales returns (retur penjualan): own account with the exact grants in docs/migration/sql/sales-return-writer-production.sql.
SALES_RETURN_WRITES_ENABLED=0
# DATABASE_URL_RETURN_WRITE=mysql://n1608204_nxret:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_smart_kopkar?connection_limit=1&max_idle_connection_lifetime=10&connect_timeout=10&pool_timeout=10

# Optional: legacy encrypted member QR (obtain through the approved secret process).
# POS_QR_CIPHER=aes-256-cbc
# POS_QR_SECRET_KEY=
# POS_QR_SECRET_IV=
