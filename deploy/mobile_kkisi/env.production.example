# Template for /opt/apps/kkisi-mobile/.env.production (mode 600). PLACEHOLDERS ONLY: never commit real values.
# Login is refused (fail closed) when anything here is missing or unsafe; /health stays up so the operator can see the app runs.
APP_ENV=production
APP_ORIGIN=https://app.kkisitb2.id
# nginx overwrites X-Forwarded-For with the client address: exactly one trusted hop.
TRUSTED_PROXY_HOPS=1
# Session-id/throttle HMAC key ring "kid:base64" (>= 32 random bytes each). A DIFFERENT key from genesis.web AUTH_SECRETS.
MEMBER_AUTH_SECRETS=k1:REPLACE_WITH_BASE64_SECRET
# REQUIRED in production: PIN pepper key ring "kid:base64" (>= 32 random bytes each, different from MEMBER_AUTH_SECRETS) for the
# shadow scrypt-p PIN credentials. Login is refused when it is missing or reuses a session key.
MEMBER_PIN_PEPPER=p1:REPLACE_WITH_BASE64_PEPPER
# Member read views through the tunnel (STAGE 3B of docs/migration/sql/mobile-member-pwa-production.sql): SELECT on the view
# schema only, never on n1608204_smart_kopkar itself.
DATABASE_URL_MEMBER_READ=mysql://n1608204_nxmread:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_kkisi_member_view
# PWA session/throttle/PIN-shadow/idempotency store: its own database and account (SELECT/INSERT/UPDATE/DELETE on that database only).
DATABASE_URL_MEMBER_AUTH=mysql://n1608204_nxmauth:REPLACE_PASSWORD@127.0.0.1:3307/n1608204_kkisi_member_auth
MEMBER_CATALOG_COMPANY_ID=1
MEMBER_DB_POOL_LIMIT=2
# P1 member intake: loan applications and deduction changes are recorded by apps/web (genesis.web) through its signed internal endpoint, reached
# over the shared Docker network kkisi-internal (never the public domain). The key ring must equal apps/web MEMBER_INTAKE_KEYS ("kid:base64", >= 32
# random bytes each, different from every other secret). ENABLE_LOAN_APPLICATION / ENABLE_DEDUCTION_CHANGE stay off unless both are set.
MEMBER_INTAKE_API_URL=http://genesis-web-netns:3000
MEMBER_INTAKE_KEYS=k1:REPLACE_WITH_BASE64_SECRET
# P2 signed member QR: Ed25519 private key "kid:base64(PKCS#8)" from `node scripts/generate-member-qr-keys.mjs <kid> <dir>`; the matching public
# key goes to genesis.web MEMBER_QR_VERIFY_KEYS. Unset = the QR screen says QR is not activated (no static or unsigned fallback).
MEMBER_QR_SIGNING_KEY=q1:REPLACE_WITH_BASE64_PKCS8
# P2 cache: how long an account's active/deleted state is reused (ms, 0..120000; 0 = check on every request). Default 30000.
MEMBER_ACCOUNT_STATE_CACHE_MS=30000
# P2 alert thresholds for GET /health?check=metrics (internal only) and the host monitor. Defaults shown.
METRICS_P95_WARN_MS=1000
METRICS_P95_CRITICAL_MS=3000
METRICS_ERROR_RATE_WARN=0.05
# Transactional writer capability flags (WS-03 §5.7). Keep all false for the read-only production release.
ENABLE_LOAN_APPLICATION=false
ENABLE_DEDUCTION_CHANGE=false
ENABLE_STORE_CHECKOUT=false
ENABLE_PPOB=false
ENABLE_MEMBER_FAVOURITES_WRITE=false
